[sub_resource type="Shader" id="Shader_bgm4u"]
code = "shader_type canvas_item;

void fragment() {
	vec4 out_color = texture(TEXTURE, UV);
	
	COLOR.rgb = out_color.rgb;
	COLOR.a = min(1.0, out_color.r + out_color.g + out_color.b);
}"

